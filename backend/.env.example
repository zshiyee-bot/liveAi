# LiveTalking Connection
LIVETALKING_BASE_URL=http://127.0.0.1:8010

# LLM（通义千问 Qwen，DashScope 兼容 OpenAI 接口）
LLM_API_KEY=sk-your-dashscope-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Embedding（通义千问 text-embedding-v4，与 LLM 共用同一把 key）
EMBEDDING_API_KEY=sk-your-dashscope-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# Queue
QUEUE_MIN_SIZE=2
QUEUE_AUTO_FILL_INTERVAL=3.0

# Memory
MEMORY_WINDOW_SIZE=10

# Database
DATABASE_URL=sqlite+aiosqlite:///data/livestream.db

# Knowledge Base
KNOWLEDGE_DOCS_PATH=data/knowledge
CHROMA_PERSIST_PATH=data/chroma_db
