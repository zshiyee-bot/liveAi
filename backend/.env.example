# LiveTalking Connection
LIVETALKING_BASE_URL=http://127.0.0.1:8010

# LLM (OpenAI-compatible)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Queue
QUEUE_MIN_SIZE=2
QUEUE_AUTO_FILL_INTERVAL=3.0

# Memory
MEMORY_WINDOW_SIZE=10

# Database
DATABASE_URL=sqlite+aiosqlite:///data/livestream.db

# Knowledge Base
KNOWLEDGE_DOCS_PATH=data/knowledge
CHROMA_PERSIST_PATH=data/chroma_db
